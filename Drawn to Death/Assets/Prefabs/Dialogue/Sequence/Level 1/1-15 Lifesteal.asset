  dialogueEntries:
  - Identifier: Line 1 - Glich
    dialogueText: '*huff* I would appreciate it *huff* if you KEPT ME ALIVE!'
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 4df0a1014765a71418098e7bdfff82da, type: 2}
