    entryVariables: []
  - Identifier: Line 2 - Glich
    dialogueText: Restore my health with the <color=#CF71E4><b>{0}</b></color>.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: dacc0cf5f81157941850ba52ca29e521, type: 2}
    dialogueSFX: 5
    entryVariables:
    - {fileID: 11400000, guid: f74d6972637d62641ab296f6a84aa86b, type: 2}
  - Identifier: Line 3 - Glich
    dialogueText: Lifesteal does not discriminate, it takes from all. Use it as you
      must and click again if it's no longer wanted.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 4df0a1014765a71418098e7bdfff82da, type: 2}
    dialogueSFX: 5
    entryVariables: []
  - Identifier: Line 4 - Glich
    dialogueText: It only needs a small touch to slow down our enemies.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 4df0a1014765a71418098e7bdfff82da, type: 2}
