  m_Script: {fileID: 11500000, guid: 7bd94d54cd5593f4eaf609a9e6454c93, type: 3}
  m_Name: End - 01 - Missing you
  m_EditorClassIdentifier: 
  activateTimeline: 0
  dialogueEntries:
  - Identifier: you  miss me
    dialogueText: Now I know how much you reeaaally miss me.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 1
    entryVariables: []
  - Identifier: I don't miss you
    dialogueText: I do not miss you at all!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: e54df98fc141cb743a1c05ce13f4f831, type: 2}
    dialogueSFX: 8
    entryVariables: []
  - Identifier: not supposed to be here
    dialogueText: Well, whatever spooky, doesn't change the fact that yer not supposed
      to be here!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 3
    entryVariables: []
  - Identifier: stop sending friends
    dialogueText: Then stop sending your "friends" to keep me company!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: e54df98fc141cb743a1c05ce13f4f831, type: 2}
    dialogueSFX: 7
    entryVariables: []
