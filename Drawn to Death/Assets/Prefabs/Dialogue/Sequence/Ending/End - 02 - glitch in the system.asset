    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 3
    entryVariables: []
  - Identifier: macaroni
    dialogueText: The whole dimension'll slip apart like macaroni with a tad too
      much butter.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 1
    entryVariables: []
  - Identifier: slip apart
    dialogueText: ......... slip apart?
