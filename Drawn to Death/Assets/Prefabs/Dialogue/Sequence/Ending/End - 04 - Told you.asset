  m_Script: {fileID: 11500000, guid: 7bd94d54cd5593f4eaf609a9e6454c93, type: 3}
  m_Name: End - 04 - Told you
  m_EditorClassIdentifier: 
  activateTimeline: 3
  dialogueEntries:
  - Identifier: Told you
    dialogueText: I told you so.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 1
    entryVariables: []
  - Identifier: 10 seconds
    dialogueText: You only told me 10 SECONDS AGO!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: e54df98fc141cb743a1c05ce13f4f831, type: 2}
    dialogueSFX: 8
    entryVariables: []
  - Identifier: loads of time
    dialogueText: 10 seconds is LOADS of time!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 3
    entryVariables: []
  - Identifier: No it isn't
    dialogueText: 'No it is not! How about a: "Don''t follow me or else the universe
      will implode"?!'
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: e54df98fc141cb743a1c05ce13f4f831, type: 2}
    dialogueSFX: 7
    entryVariables: []
  - Identifier: better idea
    dialogueText: OR EVEN BETTER, stop pestering me with your damn OODLES!
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: e54df98fc141cb743a1c05ce13f4f831, type: 2}
    dialogueSFX: 7
    entryVariables: []
  - Identifier: never need them
    dialogueText: Oh don't worry, yu'll never need them for company again.
    writeDelay: 0.05
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 1
    entryVariables: []
  - Identifier: two peas
    dialogueText: We'll have each other... Just like two peas in a pod :)
    writeDelay: 0.1
    dialogueStyle: {fileID: 11400000, guid: 0628f8b5e0fadc84a8d4ffd73461e9fb, type: 2}
    dialogueSFX: 1
    entryVariables: []
