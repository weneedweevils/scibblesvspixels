  m_GameObject: {fileID: 6296794519898475440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98630effb3a889743bb4566394de7a6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  upgradeCosts: 05000000080000000800000008000000
  upgradeDescription: A ravage ability that siphons the health from our enemies,
    adds it to our own, and slows them down.
  upgradeDescriptions:
  - "I\u2019d wager that the Oodler would be jealous of this one.\n<b>Radius: 20
    -> 24 | Damage: 15 -> 18 | Cooldown 10 -> 9</b>"
  - 'Their essences, all mine, leaving nothing but emptiness behind.

    <b>Radius:
    24 -> 28 | Damage: 18 -> 21 | Cooldown 9 -> 8</b>'
  - 'Life is a buffet, so why not feast on a little extra?

    <b>Radius: 28 ->
    32 | Damage: 21 -> 24 | Cooldown 8 -> 7</b>'
  - 'Why just sample when you can have it all?

    <b>Radius: 32 -> 36 | Damage:
    24 -> 27 | Cooldown 7 -> 6</b>'
  radiusIncrease: 4
  extraDamage: 3
  cooldownReduction: 1
