--- !u!114 &1680435065521252854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6296794519898475440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 847ae0d1743c51644a0b018405d9dccc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  upgradeCosts: 0a0000000f0000000f0000000f000000
  upgradeDescription: Our lifeblood and the very thing keeping us alive.
  upgradeDescriptions:
  - "Allows me to withstand a little more. \n<b>HP: 100 -> 125</b>"
  - "We could all do with a little more... life inside. \n<b>HP: 125 -> 150</b>"
  - "How nice, I feel more powerful already. \n<b>HP: 150 -> 175</b>"
  - "I am not a magnanimous being, the Oodler will not stand a chance. \n<b>HP: 175
    -> 200</b>"
  extraHP: 25
--- !u!114 &7825799013329462112
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6296794519898475440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a5672076c2b5fd4b836bbcce8ea70e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  upgradeCosts: 050000000a0000000f0000000f000000
  upgradeDescription: Our last resort is such a primitive weapon. We must improve
    upon its lethality.
  upgradeDescriptions:
  - 'If only a fool could wield this weapon, a fool I must be.

    <b>Damage: 15
    -> 18</b>'
  - 'Not great; not terrible... for a stick.

    <b>Damage: 18 -> 21</b>'
  - 'I begrudgingly admit, this is not bad.

    <b>Damage: 21 -> 24</b>'
  - 'This is the best it will get, I suppose.

    <b>Damage: 24 -> 27</b>'
  damageIncrease: 3
  knockbackIncrease: 1
--- !u!114 &3390813613745032266
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6296794519898475440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 578d6a99ab1d60545886a8fd7293e979, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  upgradeCosts: 060000000a0000000a0000000a000000
  upgradeDescription: "Gives purpose to death and call forth minions from those we\u2019ve
    slain."
  upgradeDescriptions:
  - 'Even doodles deserves a second chance.

    <b>Radius: 10 -> 12 | Cooldown:
    7 -> 6</b>'
  - 'Eternal servitude or an eternal nap?

    <b>Radius: 12 -> 14 | Cooldown: 6
    -> 5</b>'
  - 'Rise, RISE MY BEAUTIFUL MINIONS!!

    <b>Radius: 14 -> 16 | Cooldown: 5 ->
    4</b>'
  - "AHAHAHA, they\u2019ll all be mine! MINE!\n<b>Radius: 16 -> 18 | Cooldown: 4
    -> 3</b>"
  radiusIncrease: 2
  cooldownDecrease: 1
