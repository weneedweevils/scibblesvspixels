%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7bd94d54cd5593f4eaf609a9e6454c93, type: 3}
  m_Name: Special Note
  m_EditorClassIdentifier: 
  activateTimeline: -1
  dialogueEntries:
  - Identifier: 
    dialogueText: 'Developer note: Hello there! Sorry to break the 4th wall a little
      bit, we just wanted to explain this special soul here for you playtesters.'
    writeDelay: 0.02
    dialogueStyle: {fileID: 11400000, guid: 45abf021a51814d409709c1f82f8d90a, type: 2}
    dialogueSFX: 0
    entryVariables: []
  - Identifier: 
    dialogueText: In this playtest build, you will be skipping a couple of levels.
      That means you'd normally miss out on collecting 257 souls.
    writeDelay: 0.02
    dialogueStyle: {fileID: 11400000, guid: 45abf021a51814d409709c1f82f8d90a, type: 2}
    dialogueSFX: 0
    entryVariables: []
  - Identifier: 
    dialogueText: To keep your progression on track, this soul grants those missing
      souls. So you can continue as if you had played the missing levels.
    writeDelay: 0.02
    dialogueStyle: {fileID: 11400000, guid: 45abf021a51814d409709c1f82f8d90a, type: 2}
    dialogueSFX: 0
    entryVariables: []
  - Identifier: 
    dialogueText: This soul exists only for this playtest build. It won't appear
      in the final game, so you can ignore it when giving feedback.
    writeDelay: 0.02
    dialogueStyle: {fileID: 11400000, guid: 45abf021a51814d409709c1f82f8d90a, type: 2}
    dialogueSFX: 0
    entryVariables: []
